{
  "version": 3,
  "routes": [
    {
      "src": "^(?:/(.*))$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true,
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ]
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    }
  ],
  "framework": {
    "slug": "vite",
    "version": "8.0.16"
  },
  "crons": []
}
